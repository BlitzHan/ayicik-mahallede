{
 "surum": 1,
 "npcler": [
  {"id":"anne","ad":"Anne Ayı","alan":"aile","konusmalar":["Merhaba yavrum! Seni çok seviyorum.","Bugün hava çok güzel, haydi oynayalım!","Çiçeklerimi sulamama yardım eder misin?","Aferin sana, ne kadar yardımseversin!"]},
  {"id":"baba","ad":"Baba Ayı","alan":"aile","konusmalar":["Selam şampiyon! Gel bakalım buraya.","Yıldızları toplarsan yeni köprüler açılır!","Zıpla, zıpla! Sen çok cesursun.","Seninle çok gurur duyuyorum!"]},
  {"id":"nine","ad":"Nine Ayı","alan":"aile","konusmalar":["Hoş geldin kuzum! Seni çok özledim.","Bahçede elmalar olgunlaştı, toplar mısın?","Sana sıcacık kurabiye yaptım.","Maşallah, ne kadar da büyümüşsün!"]},
  {"id":"kuzen","ad":"Kuzen Ayı","alan":"aile","konusmalar":["Merhaba kuzen! Hadi birlikte oynayalım!","Saklambaç oynayalım mı? Sen ebesin!","Birlikte oynamak çok eğlenceli.","Sen benim en iyi arkadaşımsın!"]},

  {"id":"baykus-ogretmen","ad":"Baykuş Öğretmen","alan":"okul","konusmalar":["Günaydın minik öğrencim! Hoş geldin.","Bugün renkleri ve sayıları öğreneceğiz.","Red kırmızı, blue mavi demek!","Bir, iki, üç... One, two, three!","Harikasın, çok akıllı bir öğrencisin!"]},
  {"id":"panda","ad":"Panda Arkadaş","alan":"okul","konusmalar":["Selam! Benimle top oynar mısın?","En sevdiğin renk hangisi? Benimki yeşil!","Bambu çok lezzetli, biliyor musun?","Arkadaşlık çok güzel bir şey!"]},
  {"id":"tavsan","ad":"Tavşan Arkadaş","alan":"okul","konusmalar":["Merhaba! Ben çok hızlı zıplarım!","Havuç benim en sevdiğim yemek.","Hadi bakalım, kim daha yükseğe zıplayacak?","Sen de harika zıplıyorsun!"]},

  {"id":"dede","ad":"Dede Ayı","alan":"din","konusmalar":["Selamün aleyküm evladım! Hoş geldin.","Yemekten önce Bismillah deriz.","Yemekten sonra Elhamdülillah deriz.","Camiye girerken ayakkabılarımızı çıkarırız.","Hayvanlara iyi davranmak çok güzeldir."]},
  {"id":"tekir","ad":"Tekir Kedi","alan":"din","konusmalar":["Miyav! Merhaba, ben Tekir!","Cami bahçesi benim sıcak yuvam.","Beni sevdiğin için teşekkür ederim.","Herkes bana çok iyi davranıyor, miyav!"]},
  {"id":"pitpit","ad":"Güvercin Pıtpıt","alan":"din","konusmalar":["Gu gu! Selam, ben Pıtpıt!","Kanatlarımla gökyüzünde uçarım.","Bize buğday verirsen çok seviniriz.","Paylaşmak ne güzel, teşekkürler!"]},

  {"id":"simitci","ad":"Simitçi Ayı","alan":"kultur","konusmalar":["Hoş geldin! Sıcak simit, taze simit!","Simitlerim susamlı ve çıtır çıtır.","Simit ile çay çok yakışır!","Afiyet olsun, güzel çocuk!"]},
  {"id":"cayci","ad":"Çaycı Ayı","alan":"kultur","konusmalar":["Merhaba! Çay bahçeme hoş geldin.","Sana sıcacık bir elma çayı yaptım!","Nasreddin Hoca'yı bilir misin? Çok komikmiş!","Keloğlan masalı da çok güzeldir.","Buradan vapurları seyretmek çok güzel."]},
  {"id":"marti","ad":"Martı Mavi","alan":"kultur","konusmalar":["Gak gak! Merhaba, ben Martı Mavi!","Vapurların peşinden uçmayı çok severim.","Şuradaki kule Galata Kulesi, ne güzel!","Denizin ortasında Kız Kulesi var.","Balık benim en sevdiğim yemek!"]}
 ],

